<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="
           http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd
           http://www.springframework.org/schema/context
           http://www.springframework.org/schema/context/spring-context.xsd">

    <import resource="reclazztest-mapping-probe-spring.xml"/>
    <import resource="reclazztest-batch-infrastructure-spring.xml"/>
    <import resource="reclazztest-batch-spring.xml"/>
    <import resource="reclazztest-process-resources-spring.xml"/>

    <bean id="reclazzProbeInitDefaultsInterceptor" class="com.onurkat.reclazztest.batch.ProbeInitDefaultsInterceptor"/>
    <bean id="reclazzProbeInitDefaultsMapping" class="de.hybris.platform.servicelayer.interceptor.impl.InterceptorMapping">
        <property name="interceptor" ref="reclazzProbeInitDefaultsInterceptor"/>
        <property name="typeCode" value="ReclazzSchemaProbe"/>
    </bean>
    <bean id="reclazzProbeLoadInterceptor" class="com.onurkat.reclazztest.batch.ProbeLoadInterceptor"/>
    <bean id="reclazzProbeLoadMapping" class="de.hybris.platform.servicelayer.interceptor.impl.InterceptorMapping">
        <property name="interceptor" ref="reclazzProbeLoadInterceptor"/>
        <property name="typeCode" value="ReclazzSchemaProbe"/>
    </bean>
    <bean id="reclazzProbeRemoveInterceptor" class="com.onurkat.reclazztest.batch.ProbeRemoveInterceptor"/>
    <bean id="reclazzProbeRemoveMapping" class="de.hybris.platform.servicelayer.interceptor.impl.InterceptorMapping">
        <property name="interceptor" ref="reclazzProbeRemoveInterceptor"/>
        <property name="typeCode" value="ReclazzSchemaProbe"/>
    </bean>

    <bean id="reclazzProbePrepareInterceptor" class="com.onurkat.reclazztest.batch.ProbePrepareInterceptor"/>
    <bean id="reclazzProbePrepareMapping" class="de.hybris.platform.servicelayer.interceptor.impl.InterceptorMapping">
        <property name="interceptor" ref="reclazzProbePrepareInterceptor"/>
        <property name="typeCode" value="ReclazzSchemaProbe"/>
    </bean>

    <bean id="reclazzDynamicLabelHandler" class="com.onurkat.reclazztest.batch.DynamicLabelHandler"/>

    <bean id="reclazzProbeQueryDao" class="com.onurkat.reclazztest.batch.ProbeQueryDao">
        <constructor-arg ref="flexibleSearchService"/>
    </bean>

    <bean id="reclazzProbeSearchRestrictionDao" class="com.onurkat.reclazztest.batch.ProbeSearchRestrictionDao">
        <constructor-arg ref="flexibleSearchService"/>
    </bean>

    <!-- Services live in the web context (reclazztest-web-spring.xml); scanning them
         here too would register every listener and schedule twice. -->
    <context:component-scan base-package="com.onurkat.reclazztest.interceptors"/>

    <bean id="testValidateInterceptorMapping"
          class="de.hybris.platform.servicelayer.interceptor.impl.InterceptorMapping">
        <property name="interceptor" ref="testValidateInterceptor"/>
        <property name="typeCode" value="Product"/>
    </bean>
</beans>
