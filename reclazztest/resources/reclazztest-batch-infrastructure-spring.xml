<?xml version="1.0" encoding="UTF-8"?>
<!-- Startup infrastructure is deliberately separate from the XML edited by live tests. -->
<beans xmlns="http://www.springframework.org/schema/beans" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
       http://www.springframework.org/schema/context http://www.springframework.org/schema/context/spring-context.xsd">
    <bean id="reclazzFixtureSystemSetup" class="com.onurkat.reclazztest.batch.FixtureSystemSetup"/>
    <context:component-scan base-package="com.onurkat.reclazztest.batch"/>
    <bean id="reclazzProbeConverter" parent="abstractPopulatingConverter">
        <property name="targetClass" value="com.onurkat.reclazztest.data.ReclazzProbeData"/>
        <property name="populators"><list><ref bean="reclazzProbePopulator"/></list></property>
    </bean>
    <bean id="reclazzBatchValidatorFactory" class="org.springframework.validation.beanvalidation.LocalValidatorFactoryBean"/>
    <bean id="reclazzBatchValidation" class="com.onurkat.reclazztest.batch.ValidationFixture">
        <constructor-arg ref="reclazzBatchValidatorFactory"/>
    </bean>
</beans>
