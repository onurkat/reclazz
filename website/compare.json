    {
      "id": "reload-mechanism",
      "label": "How a change is applied",
      "cells": {
        "reclazz": {
          "text": "Redefines classes in the running JVM",
          "verdict": "yes",
          "source": {
            "record": "method-body"
          }
        },
        "jrebel": {
          "text": "Reloads classes in the running JVM",
          "verdict": "yes",
          "source": {
            "key": "https://manuals.jrebel.com/jrebel/advanced/hybris.html#2e5a8fad9d02dad7"
          }
        },
        "devtools": {
          "text": "Restarts the application in a fresh classloader",
          "verdict": "no",
          "source": {
            "key": "https://docs.spring.io/spring-boot/reference/using/devtools.html#958ae09e7d072774"
          }
        },
        "hotswap": {
          "text": "Redefines classes in the running JVM",
          "verdict": "yes",
          "source": {
            "key": "https://github.com/HotswapProjects/HotswapAgent#ee236ca61bc7921c"
          }
        }
      }
    },
    {
      "id": "state",
      "label": "What survives a change",
      "cells": {
        "reclazz": {
          "text": "Method edits keep object fields; a refreshed Spring bean is recreated and can reset its state",
          "verdict": "partial",
          "source": {
            "record": "bean"
          }
        },
        "jrebel": {
          "text": "Existing instances kept; added fields are not initialized in them",
          "verdict": "yes",
          "source": {
            "key": "https://jrebel.com/software/jrebel/learn/faq/#74da91895d2faf3e"
          }
        },
        "devtools": {
          "text": "Application state resets with the application classloader (inferred from restart mechanism)",
          "verdict": "no",
          "source": {
            "key": "https://docs.spring.io/spring-boot/reference/using/devtools.html#958ae09e7d072774"
          }
        },
        "hotswap": {
          "text": "JVM keeps running; object state not described",
          "verdict": "not-documented",
          "source": {}
        }
      }
    },
    {
      "id": "structural-stock-jdk",
      "label": "Add or remove methods and fields on a stock JDK",
      "cells": {
        "reclazz": {
          "text": "Yes on supported JDK 17+ paths, through hot-compiled callers; new members are not visible to plain reflection",
          "verdict": "partial",
          "source": {
            "record": "added-method"
          }
        },
        "jrebel": {
          "text": "Class structure changes on standard JVMs; vendor article describes the mechanism",
          "verdict": "yes",
          "source": {
            "key": "https://www.jrebel.com/blog/what-is-jrebel#46246325c4945f59"
          }
        },
        "devtools": {
          "text": "Picked up by a restart",
          "verdict": "no",
          "source": {
            "key": "https://docs.spring.io/spring-boot/reference/using/devtools.html#958ae09e7d072774"
          }
        },
        "hotswap": {
          "text": "Needs an enhanced JVM such as JetBrains Runtime (DCEVM)",
          "verdict": "no",
          "source": {
            "key": "https://github.com/HotswapProjects/HotswapAgent#ee236ca61bc7921c"
          }
        }
      }
    },
