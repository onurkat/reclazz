<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.zkoss.org/2005/zul"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.hybris.com/schema/cockpitng/zul/zul.xsd"
		height="100%">
	<div height="100%" class="reclazzprobe-container">
		<div><label id="status" value="ready" sclass="reclazzprobe-status"/></div>
		<div><button id="sendButton" label="Send probe" sclass="reclazzprobe-send"/></div>
	</div>
</widget>
