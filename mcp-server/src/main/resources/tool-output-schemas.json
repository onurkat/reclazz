{
  "reclazz_status": {
    "type": "object",
    "properties": {
      "attached": {
        "type": "boolean"
      },
      "agent": {
        "type": "string"
      },
      "protocol": {
        "type": "integer",
        "const": 1
      },
      "port": {
        "type": "integer"
      },
      "health": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "reason": {
        "type": "string"
      }
    },
    "required": [
      "attached"
    ],
    "anyOf": [
      {
        "properties": {
          "attached": {
            "const": true
          }
        },
        "required": [
          "agent",
          "protocol",
          "port",
          "health"
        ]
      },
      {
        "properties": {
          "attached": {
            "const": false
          }
        },
        "required": [
          "reason"
        ]
      }
    ],
    "$schema": "https://json-schema.org/draft/2020-12/schema"
  },
  "reclazz_scan": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "sent",
          "unavailable"
        ]
      },
      "detail": {
        "type": "string"
      },
      "reloadConfirmed": {
        "type": "boolean",
        "const": false
      }
    },
    "required": [
      "status",
      "detail",
      "reloadConfirmed"
    ],
    "$schema": "https://json-schema.org/draft/2020-12/schema"
  },
  "reclazz_build": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "acknowledged",
          "unavailable"
        ]
      },
      "state": {
        "type": "string",
        "enum": [
          "started",
          "ok",
          "failed"
        ]
      },
      "detail": {
        "type": "string"
      },
      "reloadConfirmed": {
        "type": "boolean",
        "const": false
      },
      "owner": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,64}$"
      }
    },
    "required": [
      "status",
      "state",
      "detail",
      "reloadConfirmed",
      "owner"
    ],
    "$schema": "https://json-schema.org/draft/2020-12/schema"
  },
  "reclazz_pending": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "observed",
          "unavailable"
        ]
      },
      "lines": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "detail": {
        "type": "string"
      },
      "complete": {
        "type": "boolean",
        "const": false
      }
    },
    "required": [
      "status",
      "lines",
      "detail",
      "complete"
    ],
    "$schema": "https://json-schema.org/draft/2020-12/schema"
  },
  "reclazz_diagnose": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "observed",
          "unavailable"
        ]
      },
      "lines": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "detail": {
        "type": "string"
      },
      "complete": {
        "type": "boolean",
        "const": false
      },
      "className": {
        "type": "string"
      }
    },
    "required": [
      "status",
      "lines",
      "detail",
      "complete",
      "className"
    ],
    "$schema": "https://json-schema.org/draft/2020-12/schema"
  },
  "reclazz_verify": {
    "type": "object",
    "properties": {
      "requestId": {
        "type": "string"
      },
      "sessionId": {
        "type": "string"
      },
      "className": {
        "type": "string"
      },
      "expectedSha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "observedSha256": {
        "type": "string"
      },
      "status": {
        "type": "string",
        "enum": [
          "applied",
          "failed",
          "unverified",
          "running",
          "mismatch",
          "not_observed",
          "unavailable"
        ]
      },
      "source": {
        "type": "string"
      },
      "detail": {
        "type": "string"
      },
      "completedAt": {
        "type": "string"
      }
    },
    "required": [
      "status",
      "className",
      "expectedSha256",
      "detail"
    ],
    "anyOf": [
      {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "unavailable"
            ]
          }
        }
      },
      {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "applied",
              "failed",
              "unverified",
              "running",
              "mismatch",
              "not_observed"
            ]
          }
        },
        "required": [
          "requestId",
          "sessionId",
          "className",
          "expectedSha256",
          "observedSha256",
          "status",
          "source",
          "detail",
          "completedAt"
        ]
      }
    ],
    "$schema": "https://json-schema.org/draft/2020-12/schema"
  },
  "reclazz_doctor": {
    "type": "object",
    "properties": {
      "requestId": {
        "type": "string",
        "maxLength": 512
      },
      "detail": {
        "type": "string",
        "maxLength": 512
      },
      "sessionId": {
        "type": "string",
        "maxLength": 512
      },
      "agentVersion": {
        "type": "string",
        "maxLength": 512
      },
      "pid": {
        "type": "string",
        "maxLength": 512
      },
      "javaVersion": {
        "type": "string",
        "maxLength": 512
      },
      "vmName": {
        "type": "string",
        "maxLength": 512
      },
      "workingDirectory": {
        "type": "string",
        "maxLength": 512
      },
      "status": {
        "type": "string",
        "enum": [
          "observed",
          "unavailable"
        ]
      },
      "clientWorkingDirectory": {
        "type": "string"
      },
      "nextActions": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "reloadConfirmed": {
        "type": "boolean",
        "const": false
      },
      "watcherState": {
        "type": "string",
        "enum": [
          "starting",
          "watching",
          "stopped",
          "unavailable"
        ]
      },
      "buildHold": {
        "type": "string",
        "enum": [
          "none",
          "named",
          "legacy",
          "unavailable"
        ]
      },
      "watchedDirectories": {
        "type": "array",
        "maxItems": 8,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "watchedDirectoryCount": {
        "type": "integer",
        "minimum": 0
      },
      "unwatchableDirectoryCount": {
        "type": "integer",
        "minimum": 0
      },
      "watchSampleTruncated": {
        "type": "boolean"
      },
      "buildOwnershipSupported": {
        "type": "boolean"
      },
      "verifySupported": {
        "type": "boolean"
      },
      "scanSupported": {
        "type": "boolean"
      }
    },
    "required": [
      "status",
      "detail",
      "clientWorkingDirectory",
      "nextActions",
      "reloadConfirmed"
    ],
    "allOf": [
      {
        "if": {
          "properties": {
            "status": {
              "const": "observed"
            }
          }
        },
        "then": {
          "required": [
            "requestId",
            "detail",
            "sessionId",
            "agentVersion",
            "pid",
            "javaVersion",
            "vmName",
            "workingDirectory",
            "status",
            "clientWorkingDirectory",
            "nextActions",
            "reloadConfirmed",
            "watcherState",
            "buildHold",
            "watchedDirectories",
            "watchedDirectoryCount",
            "unwatchableDirectoryCount",
            "watchSampleTruncated",
            "buildOwnershipSupported",
            "verifySupported",
            "scanSupported"
          ]
        }
      }
    ],
    "$schema": "https://json-schema.org/draft/2020-12/schema"
  }
}
