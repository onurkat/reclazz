          "unavailable"
        ]
      },
      "lines": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "detail": {
        "type": "string"
      },
      "complete": {
        "type": "boolean",
        "const": false
      }
    },
    "required": [
