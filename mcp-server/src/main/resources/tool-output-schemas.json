      "status": {
        "type": "string",
        "enum": [
          "acknowledged",
          "unavailable"
        ]
      },
      "state": {
        "type": "string",
        "enum": [
          "started",
          "ok",
          "failed"
        ]
      },
      "detail": {
        "type": "string"
      },
      "reloadConfirmed": {
        "type": "boolean",
        "const": false
      },
      "owner": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,64}$"
