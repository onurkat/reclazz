{
  "reclazz_status": {
    "type": "object",
    "properties": {
      "attached": {
        "type": "boolean"
      },
      "agent": {
        "type": "string"
      },
      "protocol": {
        "type": "integer",
        "const": 1
      },
      "port": {
        "type": "integer"
      },
      "health": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "reason": {
        "type": "string"
      }
    },
    "required": [
      "attached"
    ],
    "anyOf": [
      {
        "properties": {
          "attached": {
            "const": true
          }
        },
        "required": [
          "agent",
          "protocol",
          "port",
          "health"
        ]
      },
      {
        "properties": {
          "attached": {
            "const": false
          }
        },
        "required": [
          "reason"
        ]
      }
    ],
    "$schema": "https://json-schema.org/draft/2020-12/schema"
  },
  "reclazz_scan": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "sent",
          "unavailable"
        ]
      },
      "detail": {
        "type": "string"
      },
      "reloadConfirmed": {
        "type": "boolean",
        "const": false
      }
    },
    "required": [
      "status",
      "detail",
      "reloadConfirmed"
