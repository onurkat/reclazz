      "className": {
        "type": "string"
      },
      "expectedSha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "observedSha256": {
        "type": "string"
      },
      "status": {
        "type": "string",
        "enum": [
          "applied",
          "failed",
          "unverified",
